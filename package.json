{
  "name": "meridian-core",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:deep": "FC_RUNS=10000 vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run src/workoutSelectors.test.ts src/coreSelectors.test.ts",
    "test:data": "vitest run src/mealSelectors.test.ts src/knowledgeSelectors.test.ts src/dataSelectors.test.ts",
    "test:sync": "vitest run src/syncEngine.test.ts src/mergeStores.test.ts",
    "test:views": "vitest run src/workoutView.test.ts src/mealView.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "deep": "npm run deep:1 && npm run deep:2 && npm run deep:3",
    "bench": "vitest bench --run",
    "deep:1": "FC_RUNS=10000 vitest run src/workoutSelectors.test.ts src/coreSelectors.test.ts src/mergeStores.test.ts src/syncEngine.test.ts",
    "deep:2": "FC_RUNS=10000 vitest run src/workoutView.test.ts src/mealView.test.ts src/knowledgeView.test.ts src/knowledgeSelectors.test.ts",
    "deep:3": "FC_RUNS=10000 vitest run src/mealSelectors.test.ts src/dataSelectors.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.3",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.23.2",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  }
}
