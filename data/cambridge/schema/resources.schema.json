{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cambridge Method resources",
  "type": "object",
  "required": ["resources", "books"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string" },
    "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "use", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "use": { "type": "string" },
          "url": { "type": "string", "pattern": "^https?://" },
          "verified": { "type": "boolean" },
          "reason": { "type": "string" },
          "license": { "type": "string" },
          "note": { "type": "string" },
          "lastCheckedStatus": { "type": "integer" }
        }
      }
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "author", "title", "use"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "author": { "type": "string" },
          "title": { "type": "string" },
          "use": { "type": "string" }
        }
      }
    }
  }
}
