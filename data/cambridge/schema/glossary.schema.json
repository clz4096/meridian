{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cambridge glossary",
  "type": "object",
  "required": ["terms"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string" },
    "underline": { "type": "string", "enum": ["first", "all"] },
    "caseSensitive": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "term", "meaning", "match"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "term": { "type": "string", "pattern": "\\S" },
          "meaning": { "type": "string", "pattern": "\\S" },
          "match": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
          "us": { "type": "string" }
        }
      }
    }
  }
}
