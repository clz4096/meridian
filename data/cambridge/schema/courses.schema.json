{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Part IA and IB courses (generated by scripts/cambridge/scrape.mjs)",
  "type": "object",
  "required": [
    "scrapedAt",
    "lastVerified",
    "unlock",
    "cadence",
    "supervisionPrompt",
    "order",
    "terms",
    "courses",
    "schedules",
    "pastPapers",
    "partIB"
  ],
  "additionalProperties": false,
  "$defs": {
    "weblink": {
      "type": "object",
      "required": ["label", "url", "verified"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["student", "lecturer", "hub"] },
        "label": { "type": "string" },
        "url": { "type": "string", "pattern": "^https?://" },
        "verified": { "type": "boolean" },
        "reason": { "type": "string" },
        "httpOnly": { "type": "boolean" },
        "ravenOnly": { "type": "boolean" },
        "lastCheckedStatus": { "type": "integer" },
        "upstreamMissing": { "type": "boolean" }
      }
    },
    "sheet": {
      "type": "object",
      "required": ["n", "label", "url", "verified"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer" },
        "label": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" },
        "updated": { "type": "string" },
        "verified": { "type": "boolean" },
        "reason": { "type": "string" },
        "httpOnly": { "type": "boolean" },
        "lastCheckedStatus": { "type": "integer" },
        "upstreamMissing": { "type": "boolean" },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
      }
    },
    "course": {
      "type": "object",
      "required": ["id", "name", "side", "page", "sheets", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^i[ab]-[a-z0-9-]+$" },
        "name": { "type": "string", "pattern": "\\S" },
        "term": { "type": "string", "enum": ["michaelmas", "lent", "easter"] },
        "side": { "type": "string", "enum": ["pure", "applied"] },
        "page": { "type": "string", "pattern": "^https://" },
        "damtpCode": { "type": "string", "pattern": "^[A-D]\\d+$" },
        "sheetYear": { "type": "string", "pattern": "^\\d{4}-\\d{4}$" },
        "sheets": { "type": "array", "items": { "$ref": "#/$defs/sheet" } },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/weblink" } },
        "pastPapers": { "type": "string", "enum": ["partIA"] },
        "schedule": { "type": "string", "enum": ["schedules"] },
        "supervisionPrompt": { "type": "string", "pattern": "\\{n\\}" },
        "sameAs": { "type": "string" },
        "note": { "type": "string" },
        "siteNote": { "type": "string" },
        "upstreamMissing": { "type": "boolean" }
      }
    },
    "question": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "label": { "type": "string", "pattern": "\\S" },
        "step": { "type": "string", "pattern": "^(\\d{4}|Specimen) STEP [123] Q\\d+$" },
        "note": { "type": "string" }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string" },
    "scrapedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "unlock": {
      "type": "object",
      "required": ["afterGate"],
      "additionalProperties": false,
      "properties": { "afterGate": { "type": "string" } }
    },
    "cadence": {
      "type": "object",
      "required": ["sheetsPerCourse", "supervisionsPerSheet", "coursesAtOnce"],
      "additionalProperties": false,
      "properties": {
        "sheetsPerCourse": { "type": "integer" },
        "supervisionsPerSheet": { "type": "integer" },
        "coursesAtOnce": { "type": "integer" }
      }
    },
    "supervisionPrompt": { "type": "string", "pattern": "\\{course\\}.*\\{n\\}" },
    "order": {
      "type": "array",
      "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "cambridge", "optional", "pure", "applied"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["michaelmas", "lent", "easter"] },
          "name": { "type": "string", "pattern": "\\S" },
          "cambridge": { "type": "string" },
          "optional": { "type": "boolean" },
          "pure": { "type": "array", "items": { "type": "string" } },
          "applied": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "courses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/course" } },
    "schedules": {
      "type": "object",
      "required": ["url", "verified"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "verified": { "type": "boolean" },
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "lastCheckedStatus": { "type": "integer" },
        "httpOnly": { "type": "boolean" }
      }
    },
    "pastPapers": {
      "type": "object",
      "required": ["partIA"],
      "additionalProperties": false,
      "properties": {
        "partIA": {
          "type": "object",
          "required": ["url", "verified", "years"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "verified": { "type": "boolean" },
            "reason": { "type": "string" },
            "note": { "type": "string" },
            "years": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["year", "url", "verified", "papers"],
                "additionalProperties": false,
                "properties": {
                  "year": { "type": "integer" },
                  "url": { "type": "string", "pattern": "^https://" },
                  "verified": { "type": "boolean" },
                  "reason": { "type": "string" },
                  "papers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["label", "url", "verified"],
                      "additionalProperties": false,
                      "properties": {
                        "label": { "type": "string" },
                        "url": { "type": "string", "pattern": "^https://" },
                        "verified": { "type": "boolean" },
                        "reason": { "type": "string" },
                        "lastCheckedStatus": { "type": "integer" },
                        "upstreamMissing": { "type": "boolean" }
                      }
                    }
                  },
                  "lastCheckedStatus": { "type": "integer" },
                  "upstreamMissing": { "type": "boolean" }
                }
              }
            },
            "lastCheckedStatus": { "type": "integer" }
          }
        }
      }
    },
    "partIB": { "type": "array", "items": { "$ref": "#/$defs/course" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
