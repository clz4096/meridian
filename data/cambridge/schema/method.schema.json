{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cambridge study loop",
  "type": "object",
  "required": ["steps", "cadence", "questionStatus", "errorCauses"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "do"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["read", "attempt", "writeup", "supervision", "redo"] },
          "name": { "type": "string" },
          "do": { "type": "string" },
          "minMinutes": { "type": "number" },
          "minutes": { "type": "number" },
          "withinHours": { "type": "number" }
        }
      }
    },
    "cadence": {
      "type": "object",
      "required": ["supervisionsPerWeek", "suggestedDays", "sabbath"],
      "additionalProperties": false,
      "properties": {
        "supervisionsPerWeek": { "type": "integer" },
        "suggestedDays": { "type": "array", "items": { "type": "string", "enum": ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"] } },
        "sabbath": { "type": "string" }
      }
    },
    "questionStatus": { "type": "array", "items": { "type": "string", "enum": ["solved", "partial", "stuck"] } },
    "errorCauses": { "type": "array", "items": { "type": "string", "enum": ["concept", "algebra slip", "didn't see the idea", "ran out of time"] } }
  }
}
