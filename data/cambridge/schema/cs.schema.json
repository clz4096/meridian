{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cambridge Computer Science Tripos: course list plus the CS study track (generated by scripts/cambridge/scrape.mjs, then hand-edited)",
  "type": "object",
  "required": ["scrapedAt", "lastVerified", "features", "tripos", "track"],
  "additionalProperties": false,
  "$defs": {
    "material": {
      "type": "object",
      "required": ["kind", "label", "url", "verified"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["notes", "exercises", "videos", "pastPapers", "moodle"] },
        "label": { "type": "string", "pattern": "\\S" },
        "url": { "type": "string", "pattern": "^https?://" },
        "verified": { "type": "boolean" },
        "reason": { "type": "string" },
        "httpOnly": { "type": "boolean" },
        "ravenOnly": { "type": "boolean" },
        "lastCheckedStatus": { "type": "integer" },
        "upstreamMissing": { "type": "boolean" }
      }
    },
    "course": {
      "type": "object",
      "required": ["id", "code", "name", "url", "terms"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^cs-(ia|ib|ii)-[a-z0-9+-]+$" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://www\\.cl\\.cam\\.ac\\.uk/teaching/2627/" },
        "terms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "hours": { "type": "integer" },
        "available": {
          "type": "object",
          "required": ["notes", "exercises", "videos", "pastPapers"],
          "additionalProperties": false,
          "properties": {
            "notes": { "type": "boolean" },
            "exercises": { "type": "boolean" },
            "videos": { "type": "boolean" },
            "pastPapers": { "type": "boolean" }
          }
        },
        "materials": {
          "type": "object",
          "required": ["year", "page", "links"],
          "additionalProperties": false,
          "properties": {
            "year": { "type": "string" },
            "page": { "type": "string", "pattern": "^https://" },
            "links": { "type": "array", "items": { "$ref": "#/$defs/material" } }
          }
        },
        "recordingsPage": { "type": "string", "pattern": "^https://" },
        "pastPapers": {
          "type": "object",
          "required": ["url", "verified"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "verified": { "type": "boolean" },
            "reason": { "type": "string" },
            "lastCheckedStatus": { "type": "integer" },
            "httpOnly": { "type": "boolean" }
          }
        },
        "note": { "type": "string" },
        "siteNote": { "type": "string" },
        "upstreamMissing": { "type": "boolean" }
      }
    },
    "part": {
      "type": "object",
      "required": ["url", "courses"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "courses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/course" } }
      }
    }
 ,
    "trackPhase": {
      "type": "object",
      "required": ["id", "order", "name", "do", "pace", "gate", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "enum": ["CS-0", "CS-IA", "CS-IB"] },
        "order": { "type": "integer" },
        "name": { "type": "string", "pattern": "\\S" },
        "do": { "type": "string", "pattern": "\\S" },
        "pace": { "$ref": "common.schema.json#/$defs/pace" },
        "gate": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/gate" }] },
        "items": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "blocks": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "unlockAfter": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
        "alongside": { "type": "string" },
        "triposPart": { "type": "string", "enum": ["IA", "IB", "II"] },
        "suggestedOrder": {
          "type": "object",
          "required": ["label", "steps"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "const": "suggested" },
            "note": { "type": "string" },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } }
            }
          }
        },
        "note": { "type": "string" }
      }
    },
    "trackBlock": {
      "type": "object",
      "required": ["id", "phase", "name", "do", "pace", "gate", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(cs0|csia)-[a-z0-9-]+$" },
        "phase": { "type": "string", "enum": ["CS-0", "CS-IA", "CS-IB"] },
        "name": { "type": "string", "pattern": "\\S" },
        "do": { "type": "string", "pattern": "\\S" },
        "pace": { "$ref": "common.schema.json#/$defs/pace" },
        "gate": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/gate" }] },
        "items": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
        "alongside": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "trackItem": {
      "type": "object",
      "required": ["id", "phase", "kind", "n", "title", "links", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(tmua|bop|nstwb|ocaml|focs|prep|cst|nst)-[a-z0-9-]+$" },
        "phase": { "type": "string", "enum": ["CS-0", "CS-IA", "CS-IB"] },
        "block": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["notes", "spec", "paper", "chapter", "checklist", "course", "practical", "syllabus"]
        },
        "n": { "type": "integer" },
        "title": { "type": "string", "pattern": "\\S" },
        "siteTitle": { "type": "string" },
        "course": { "type": "string", "pattern": "^cs-(ia|ib|ii)-[a-z0-9+-]+$" },
        "paper": { "type": "integer", "enum": [1, 2, 3] },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["Michaelmas term", "Lent term", "Easter term"] }
        },
        "prerequisites": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "optional": { "type": "boolean" },
        "examined": { "type": "boolean" },
        "books": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "topics": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "links": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/link" } },
        "notes": { "type": "array", "items": { "type": "string" } },
        "questions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/question" } },
        "questionsNote": { "type": "string" },
        "upstreamMissing": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "course" } } },
          "then": { "required": ["course", "paper", "terms"] }
        },
        {
          "if": { "properties": { "kind": { "const": "practical" } } },
          "then": { "required": ["course", "examined"] }
        }
      ]
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string" },
    "scrapedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "note": { "type": "string" } }
      }
    },
    "tripos": {
      "type": "object",
      "required": ["name", "year", "pastPapers", "parts"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "year": { "type": "string" },
        "pastPapers": {
          "type": "object",
          "required": ["url", "verified"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "verified": { "type": "boolean" },
            "reason": { "type": "string" },
            "lastCheckedStatus": { "type": "integer" },
            "httpOnly": { "type": "boolean" }
          }
        },
        "parts": {
          "type": "object",
          "required": ["IA", "IB", "II"],
          "additionalProperties": false,
          "properties": { "IA": { "$ref": "#/$defs/part" }, "IB": { "$ref": "#/$defs/part" }, "II": { "$ref": "#/$defs/part" } }
        }
      }
    }
,
    "track": {
      "type": "object",
      "required": ["supervisorPrompt", "phases", "blocks", "items"],
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string" },
        "supervisorPrompt": {
          "type": "object",
          "required": ["replaces", "text", "codeLanguages", "note"],
          "additionalProperties": false,
          "properties": {
            "replaces": { "type": "string", "pattern": "\\S" },
            "text": { "type": "string", "pattern": "\\{course\\}.*\\{n\\}" },
            "codeLanguages": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "\\S" }
            },
            "note": { "type": "string", "pattern": "\\S" }
          }
        },
        "phases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trackPhase" } },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/trackBlock" } },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trackItem" } }
      }
    }
  }
}
