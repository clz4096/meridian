{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Underground Mathematics stations and block mapping",
  "type": "object",
  "required": ["site", "mapping", "stations", "blocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string" },
    "site": { "type": "string", "pattern": "^https://" },
    "mapping": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": { "label": { "type": "string", "const": "suggested" }, "note": { "type": "string" } }
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "has", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://undergroundmathematics\\.org/" },
          "has": {
            "type": "object",
            "required": ["introducing", "developing", "review"],
            "additionalProperties": false,
            "properties": { "introducing": { "type": "boolean" }, "developing": { "type": "boolean" }, "review": { "type": "boolean" } }
          },
          "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string" }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block", "stations"],
        "additionalProperties": false,
        "properties": {
          "block": { "type": "string" },
          "stations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "layer1": {
      "type": "object",
      "required": ["courses"],
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string" },
        "courses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" }, "note": { "type": "string" } }
          }
        }
      }
    }
  }
}
