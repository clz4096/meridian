{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared definitions for the study tracks (step.json and the track in cs.json)",
  "description": "Both tracks use the same phase, gate, question and link shapes so the same screens and catalog adapter serve both. Referenced as common.schema.json#/$defs/<name>.",
  "$defs": {
    "link": {
      "type": "object",
      "required": ["kind", "label", "url", "verified"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "assignment",
            "hints",
            "video",
            "solutions",
            "topicNotes",
            "questions",
            "course",
            "materials",
            "notes",
            "exercises",
            "videos",
            "pastPapers",
            "answers",
            "spec",
            "book",
            "page"
          ]
        },
        "label": { "type": "string", "pattern": "\\S" },
        "url": { "type": "string", "pattern": "^https://" },
        "role": { "type": "string", "enum": ["worked-solution", "further"] },
        "verified": { "type": "boolean" },
        "reason": { "type": "string" },
        "httpOnly": { "type": "boolean" },
        "ravenOnly": { "type": "boolean" },
        "lastCheckedStatus": { "type": "integer" },
        "upstreamMissing": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-zA-Z0-9]+$" },
        "label": { "type": "string", "pattern": "\\S" },
        "type": { "type": "string", "enum": ["text", "number", "yesno"] }
      }
    },
    "gate": {
      "type": "object",
      "required": ["text", "xp", "evidence"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "pattern": "\\S" },
        "xp": { "type": "integer" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "pace": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "pattern": "\\S" },
        "perWeek": { "type": "number" },
        "maxWeeks": { "type": "number" },
        "unit": { "type": "string", "enum": ["assignment", "problem", "module", "paper", "chapter", "course", "supervision"] }
      }
    },
    "question": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "label": { "type": "string", "pattern": "\\S" },
        "step": { "type": "string", "pattern": "^(\\d{4}|Specimen) STEP [123] Q\\d+$" },
        "link": { "type": "string", "pattern": "^https://" },
        "note": { "type": "string" }
      }
    }
  }
}
