{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STEP main track (generated by scripts/cambridge/scrape.mjs)",
  "type": "object",
  "required": ["source", "lastVerified", "scrapedAt", "exam", "phases", "blocks", "items"],
  "additionalProperties": false,
  "$defs": {
    "link": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/link" },
        { "properties": { "kind": { "enum": ["assignment", "hints", "video", "solutions", "topicNotes", "questions"] } } }
      ]
    },
    "evidence": { "$ref": "common.schema.json#/$defs/evidence" },
    "question": { "$ref": "common.schema.json#/$defs/question" }
  },
  "properties": {
    "$schema": { "type": "string" },
    "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string" },
    "source": { "type": "string", "pattern": "^https://" },
    "scrapedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "exam": {
      "type": "object",
      "required": ["durationMin", "questions", "sections", "answerAtMost", "bestCount", "marksPerQuestion", "maxMarks"],
      "additionalProperties": false,
      "properties": {
        "durationMin": { "type": "integer", "const": 180 },
        "questions": { "type": "integer", "const": 12 },
        "sections": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "type": "object",
              "required": ["name", "count"],
              "additionalProperties": false,
              "properties": { "name": { "type": "string", "pattern": "\\S" }, "count": { "type": "integer", "const": 8 } }
            },
            {
              "type": "object",
              "required": ["name", "count"],
              "additionalProperties": false,
              "properties": { "name": { "type": "string", "pattern": "\\S" }, "count": { "type": "integer", "const": 2 } }
            },
            {
              "type": "object",
              "required": ["name", "count"],
              "additionalProperties": false,
              "properties": { "name": { "type": "string", "pattern": "\\S" }, "count": { "type": "integer", "const": 2 } }
            }
          ],
          "items": {
            "type": "object",
            "required": ["name", "count"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "count": { "type": "integer" } }
          }
        },
        "answerAtMost": { "type": "integer", "const": 6 },
        "bestCount": { "type": "integer", "const": 6 },
        "marksPerQuestion": { "type": "integer", "const": 20 },
        "maxMarks": { "type": "integer", "const": 120 }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "name", "do", "pace", "gate", "items"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["0", "A", "A+", "B", "C", "D"] },
          "order": { "type": "integer" },
          "name": { "type": "string", "pattern": "\\S" },
          "do": { "type": "string", "pattern": "\\S" },
          "pace": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/pace" },
              { "properties": { "unit": { "enum": ["assignment", "problem", "module", "paper"] } } }
            ]
          },
          "alongside": { "type": "string" },
          "uses": { "type": "array", "items": { "type": "string" } },
          "resources": { "type": "array", "items": { "type": "string" } },
          "items": { "type": "array", "items": { "type": "string" } },
          "gate": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/gate" }] }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "undergroundBlock", "assignments", "items"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "undergroundBlock": { "type": "string" },
          "assignments": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
          "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phase", "kind", "n", "title", "questions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(found-\\d{2}|extra-[a-z]+|siklos-p\\d{2}|s2-[a-z-]+|s3-[a-z-]+)$" },
          "phase": { "type": "string", "enum": ["A", "A+", "B", "C"] },
          "block": { "type": "string" },
          "kind": { "type": "string", "enum": ["assignment", "set", "siklos", "module"] },
          "n": { "type": "integer" },
          "title": { "type": "string", "pattern": "\\S" },
          "siteTitle": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://step\\.maths\\.org/" },
          "topics": { "type": "array", "items": { "type": "string" } },
          "siteTopics": { "type": "string" },
          "stepQuestions": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4} STEP [123] Q\\d+$" } },
          "resource": { "type": "string" },
          "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
          "notes": { "type": "array", "items": { "type": "string" } },
          "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } },
          "questionsNote": { "type": "string" },
          "upstreamMissing": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "assignment" } }
            },
            "then": {
              "required": ["block", "topics", "links", "url"],
              "properties": {
                "topics": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
                "links": { "type": "array", "minItems": 1 }
              }
            }
          },
          {
            "if": {
              "properties": { "kind": { "enum": ["module", "set"] } }
            },
            "then": {
              "required": ["links", "url"],
              "properties": { "links": { "type": "array", "minItems": 1 } }
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "siklos" } }
            },
            "then": { "required": ["resource"] }
          }
        ]
      }
    }
  }
}
